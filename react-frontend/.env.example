# Optional: Copy this file to .env.local to customize your local dev server proxy.
# .env.local is ignored by Git, so your local machine settings will never be pushed to GitHub.
#
# By default (without .env.local), Vite proxies /api requests to your local backend (http://localhost:8080).
# If you want your local frontend to point to your live VPS backend instead:
# VITE_API_PROXY_TARGET=https://business.asknehru.com
